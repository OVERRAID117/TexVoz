              {/* ── Cards dinámicas desde Supabase ── */}
              {loadingPlans && (
                <div className={styles.planCard} style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', minHeight: 200, opacity: 0.5 }}>
                  <span>Cargando planes...</span>
                </div>
              )}

              {!loadingPlans && plansError && (
