                      </li>
                    </ul>
                    <button
                      className={isFeatured ? styles.btnPlanPro : styles.btnPlanFree}
                      onClick={() => {
                        if (plan.name === 'pro') {
                          window.location.href = '/checkout/pro'
                        } else if (plan.name === 'empresarial') {
