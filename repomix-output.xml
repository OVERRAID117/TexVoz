'use client'

import { useEffect, useState, useMemo } from 'react'
import { useRouter } from 'next/navigation'
import type { Session } from '@supabase/supabase-js'
import { supabase } from '@/lib/supabase'
import Nav from '../components/Nav'
import FileWizard, { type HistoryRow } from '../components/FileWizard'
import styles from '../page.module.css'

// ── Tipos ───────────────────────────────────────────────────────────
// Reutiliza la forma real de la fila tal como la define y devuelve FileWizard/Supabase
type HistoryItem = HistoryRow

// ── Helpers ─────────────────────────────────────────────────────────
const MODE_EMOJI: Record<string, string> = {
  explicar: '🧠', resumir: '📌', ordenar: '🗂️', simplificar: '✨',
}
const LENGTH_COLOR: Record<string, string> = {
  corto: '#059669', medio: '#b8860b', largo: '#7c3aed', completo: '#1a1a2e',
}

function fileIcon(name: string) {
  const ext = name?.split('.').pop()?.toLowerCase()
  if (ext === 'pdf')  return '📄'
  if (ext === 'docx' || ext === 'doc') return '📝'
  return '🗒️'
}

function downloadTxt(item: HistoryItem) {
  const blob = new Blob([item.result_text], { type: 'text/plain;charset=utf-8' })
  const url  = URL.createObjectURL(blob)
  const a    = document.createElement('a')
  a.href     = url
  a.download = `${item.file_name.replace(/\.[^/.]+$/, '')}_${item.mode}.txt`
  a.click()
  URL.revokeObjectURL(url)
}

async function downloadFromHistory(item: HistoryItem) {
  // Registros viejos sin formato → descargar TXT directo del texto en memoria
  if (!item.output_format || !item.output_filename) {
    downloadTxt(item)
    return
  }
  // Registros nuevos → regenerar el archivo en el formato original
  try {
    const res = await fetch('/api/generate-doc', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        text:     item.result_text,
        format:   item.output_format,
        fileName: item.output_filename.replace(/\.[^/.]+$/, ''),
      }),
    })
    if (!res.ok) throw new Error('Error al regenerar documento')
    const blob = await res.blob()
    const url  = URL.createObjectURL(blob)
    const a    = document.createElement('a')
    a.href     = url
    a.download = item.output_filename
    a.click()
    URL.revokeObjectURL(url)
  } catch (err) {
    console.error('[downloadFromHistory]', err)
    alert('No se pudo descargar. Intenta de nuevo.')
  }
}

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('es-MX', {
    day: '2-digit', month: 'short', year: 'numeric',
    hour: '2-digit', minute: '2-digit',
  })
}

// ── Componente ───────────────────────────────────────────────────────
export default function DashboardPage() {
  const [session,        setSession]        = useState<Session | null>(null)
  const [checkingSession, setCheckingSession] = useState(true)
  const [history,        setHistory]        = useState<HistoryItem[]>([])
  const [loadingHistory, setLoadingHistory] = useState(false)

  // filtros y búsqueda (client-side, rápido)
  const [searchQuery,   setSearchQuery]   = useState('')
  const [filterMode,    setFilterMode]    = useState('todos')
  const [filterLength,  setFilterLength]  = useState('todos')
  const [filterFileType, setFilterFileType] = useState('todos')
  const [sortOrder,     setSortOrder]     = useState<'desc' | 'asc'>('desc')

  // modales
  const [selectedItem,    setSelectedItem]    = useState<HistoryItem | null>(null)
  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null)
  const [deleting,        setDeleting]        = useState(false)

  // id del item recién agregado — controla la animación de entrada sutil
  const [newItemId, setNewItemId] = useState<string | null>(null)

  const router = useRouter()

  // Se llama desde FileWizard cuando una explicación se guarda con éxito en document_history.
  // Antepone la fila real al historial — sin refrescar, sin volver a consultar Supabase.
  const handleNewHistoryItem = (row: HistoryItem) => {
    setHistory(prev => [row, ...prev])
    setNewItemId(row.id)
    setTimeout(() => setNewItemId(curr => (curr === row.id ? null : curr)), 300)
  }

  // ── Fetch historial ────────────────────────────────────────────────
  const fetchHistory = async (userId: string) => {
    setLoadingHistory(true)
    const { data, error } = await supabase
      .from('document_history')
      .select('id, file_name, mode, result_length, result_text, created_at, user_id, output_format, output_filename')
      .eq('user_id', userId)
      .order('created_at', { ascending: false }) // siempre traemos desc; el sort visual es client-side
    if (error) console.error('[history fetch error]', error)
    else setHistory(data || [])
    setLoadingHistory(false)
  }

  useEffect(() => {
    supabase.auth.getSession().then(async ({ data }) => {
      if (!data.session) { router.push('/'); return }
      setSession(data.session)
      setCheckingSession(false)
      await fetchHistory(data.session.user.id)
    })

    const { data: listener } = supabase.auth.onAuthStateChange((_event, newSession) => {
      if (!newSession) router.push('/')
      else setSession(newSession)
    })
    return () => listener.subscription.unsubscribe()
  }, [router])

  // ── Filtrado + búsqueda + sort (client-side) ────────────────────────
  const filteredHistory = useMemo(() => {
    const q = searchQuery.toLowerCase().trim()
  return history
  .filter(item => {
    const matchSearch = !q ||
      item.file_name?.toLowerCase().includes(q) ||
      item.result_text?.toLowerCase().includes(q)
    const matchMode     = filterMode     === 'todos' || item.mode          === filterMode
    const matchLength   = filterLength   === 'todos' || item.result_length === filterLength
    const ext           = item.file_name?.split('.').pop()?.toLowerCase() ?? ''
    const matchFileType = filterFileType === 'todos' || (item.output_format ?? 'txt') === filterFileType
    return matchSearch && matchMode && matchLength && matchFileType
  })
      .sort((a, b) => {
        const diff = new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
        return sortOrder === 'desc' ? diff : -diff
      })
}, [history, searchQuery, filterMode, filterLength, filterFileType, sortOrder])

  // ── Delete ─────────────────────────────────────────────────────────
  const handleDelete = async (id: string) => {
    setDeleting(true)
    const { error } = await supabase.from('document_history').delete().eq('id', id)
    if (error) {
      console.error('[delete error]', error)
      alert('No se pudo eliminar. Intenta de nuevo.')
    } else {
      setHistory(prev => prev.filter(item => item.id !== id))
      if (selectedItem?.id === id) setSelectedItem(null)
    }
    setConfirmDeleteId(null)
    setDeleting(false)
  }

  // ── Loading guard ──────────────────────────────────────────────────
  if (checkingSession) {
    return (
      <div className={styles.page}>
        <Nav />
        <div style={{ textAlign: 'center', padding: '4rem', color: '#9090aa' }}>Cargando…</div>
      </div>
    )
  }

  const displayName =
    session?.user.user_metadata?.full_name ||
    session?.user.user_metadata?.name ||
    session?.user.email

const hasFilters = searchQuery || filterMode !== 'todos' || filterLength !== 'todos' || filterFileType !== 'todos'

  // ── Render ─────────────────────────────────────────────────────────
  return (
    <div className={styles.page}>
      <Nav />

      <div style={{ maxWidth: 880, margin: '0 auto', padding: '2.5rem 1.5rem 4rem' }}>

        {/* ── Bienvenida ── */}
        <h1 style={{ fontFamily: "'Instrument Serif', serif", fontSize: 32, margin: '0 0 4px', color: '#1a1a2e' }}>
          Hola, {displayName} 👋
        </h1>
        <p style={{ color: '#6b6b8a', fontSize: 14, margin: '0 0 28px' }}>
          Este es tu panel de VozEstudio.
        </p>

        {/* ── Plan actual ── */}
        <div className={styles.planCard} style={{ width: '100%', marginBottom: 24 }}>
          <div className={styles.planHeader}>
            <span className={styles.planEmoji}>📋</span>
            <div>
              <div className={styles.planName}>Plan actual</div>
              <div className={styles.planPrice}>Sin plan activo</div>
            </div>
          </div>
          <p style={{ color: '#6b6b8a', fontSize: 13, margin: '8px 0 16px' }}>
            Aún no tienes una suscripción activa. Elige un plan para desbloquear más documentos y funciones.
          </p>
          <button className={styles.btnPlanPro} onClick={() => { window.location.href = '/#planes' }}>
            Ver planes disponibles
          </button>
        </div>

        {/* ── Área de trabajo ── */}
        <section style={{ marginBottom: 40 }}>
          <h2 className={styles.sectionTitle} style={{ fontSize: 22, marginBottom: 4 }}>
            Área de trabajo
          </h2>
          <p style={{ color: '#6b6b8a', fontSize: 14, margin: '0 0 20px' }}>
            Sube un documento y genera tu explicación.
          </p>
          <FileWizard onSaved={handleNewHistoryItem} />
        </section>

        {/* ── Consumo del plan ── */}
        <section style={{ marginBottom: 32 }}>
          <h2 className={styles.sectionTitle} style={{ fontSize: 22, marginBottom: 12 }}>Consumo del plan</h2>
          <div style={{ background: '#fff', border: '1px solid #e8e4dc', borderRadius: 16, padding: '1.5rem' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 13, color: '#6b6b8a', marginBottom: 8 }}>
              <span>Documentos usados este mes</span>
              <span>— / —</span>
            </div>
            <div style={{ background: '#f5f3ee', borderRadius: 8, height: 8, overflow: 'hidden' }}>
              <div style={{ background: '#e8e4dc', height: '100%', width: '0%' }} />
            </div>
            <p style={{ color: '#9090aa', fontSize: 12, marginTop: 10 }}>Disponible cuando actives un plan.</p>
          </div>
        </section>

        {/* ── Historial ── */}
        <section style={{ marginBottom: 32 }}>

          {/* Cabecera historial */}
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 16, flexWrap: 'wrap', gap: 10 }}>
            <h2 className={styles.sectionTitle} style={{ fontSize: 22, margin: 0 }}>
              Historial
            </h2>
            {history.length > 0 && (
              <span style={{ fontSize: 12, color: '#9090aa', background: '#f5f3ee', padding: '3px 12px', borderRadius: 20 }}>
                {filteredHistory.length} de {history.length} documentos
              </span>
            )}
          </div>

          {/* ── Buscador + filtros (solo si hay historial) ── */}
          {history.length > 0 && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 10, marginBottom: 16 }}>
              <input
                type="text"
                placeholder="🔍 Buscar por nombre de archivo o contenido..."
                value={searchQuery}
                onChange={e => setSearchQuery(e.target.value)}
                style={{
                  width: '100%', padding: '11px 16px', borderRadius: 12,
                  border: '1.5px solid #e8e4dc', fontSize: 14, outline: 'none',
                  fontFamily: "'Nunito', sans-serif", boxSizing: 'border-box',
                }}
                onFocus={e  => (e.target.style.borderColor = '#00c9a7')}
                onBlur={e   => (e.target.style.borderColor = '#e8e4dc')}
              />

              <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center' }}>
               {/* ← NUEVO: Tipo de documento */}
              <select value={filterFileType} onChange={e => setFilterFileType(e.target.value)}
                style={{ padding: '8px 12px', borderRadius: 10, border: '1.5px solid #e8e4dc', fontSize: 13, fontFamily: "'Nunito', sans-serif", background: '#fff', cursor: 'pointer' }}>
                <option value="todos">📁 Todos los tipos</option>
                <option value="pdf">📄 PDF</option>
                <option value="docx">📝 Word (.docx)</option>
                <option value="txt">🗒️ Texto (.txt)</option>
              </select>


                {/* Longitud */}
                <select value={filterLength} onChange={e => setFilterLength(e.target.value)}
                style={{ padding: '8px 12px', borderRadius: 10, border: '1.5px solid #e8e4dc', fontSize: 13, fontFamily: "'Nunito', sans-serif", background: '#fff', cursor: 'pointer' }}>
                <option value="todos">📏 Todas las longitudes</option>
                <option value="corto">Corto</option>
                <option value="medio">Medio</option>
                <option value="largo">Largo</option>
                <option value="completo">Completo</option>
              </select>

                {/* Orden fecha */}
                <button onClick={() => setSortOrder(o => o === 'desc' ? 'asc' : 'desc')}
                  style={{ padding: '8px 14px', borderRadius: 10, border: '1.5px solid #e8e4dc', fontSize: 13, background: '#fff', cursor: 'pointer', fontFamily: "'Nunito', sans-serif" }}>
                  {sortOrder === 'desc' ? '↓ Más recientes' : '↑ Más antiguos'}
                </button>

                {/* Limpiar filtros */}
                {hasFilters && (
                  <button
                    onClick={() => { setSearchQuery(''); setFilterMode('todos'); setFilterLength('todos'); setFilterFileType('todos') }}
                    style={{ padding: '8px 14px', borderRadius: 10, border: '1.5px solid #e8e4dc', fontSize: 13, background: '#f5f3ee', cursor: 'pointer', color: '#9090aa', fontFamily: "'Nunito', sans-serif" }}>
                    ✕ Limpiar filtros
                  </button>
                )}
              </div>
            </div>
          )}

          {/* ── Estados ── */}
          {loadingHistory && (
            <div style={{ background: '#fff', border: '1px solid #e8e4dc', borderRadius: 16, padding: '2rem', textAlign: 'center', color: '#9090aa', fontSize: 14 }}>
              Cargando historial…
            </div>
          )}

          {!loadingHistory && history.length === 0 && (
            <div style={{ background: '#fff', border: '1px dashed #e8e4dc', borderRadius: 16, padding: '2.5rem 1.5rem', textAlign: 'center', color: '#9090aa', fontSize: 14 }}>
              Aún no has explicado ningún documento.<br />Tus análisis aparecerán aquí.
            </div>
          )}

          {!loadingHistory && history.length > 0 && filteredHistory.length === 0 && (
            <div style={{ background: '#fff', border: '1px dashed #e8e4dc', borderRadius: 16, padding: '2.5rem 1.5rem', textAlign: 'center', color: '#9090aa', fontSize: 14 }}>
              No se encontraron coincidencias. Intenta con otra búsqueda o cambia los filtros.
            </div>
          )}

          {/* ── Lista ── */}
          {!loadingHistory && filteredHistory.length > 0 && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
              {filteredHistory.map(item => {
                const preview = item.result_text?.slice(0, 200).trim()
                const hasMore = (item.result_text?.length ?? 0) > 200

                return (
                  <div
                    key={item.id}
                    className={item.id === newItemId ? styles.historyItemNew : undefined}
                    style={{ background: '#fff', border: '1.5px solid #e8e4dc', borderRadius: 16, padding: '18px 20px' }}
                  >

                    {/* Fila superior: icono + nombre + fecha + badges */}
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', flexWrap: 'wrap', gap: 8, marginBottom: 10 }}>
                      <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
                      <span style={{ fontSize: 22 }}>
                      {item.output_format === 'pdf'  ? '📄'
                      : item.output_format === 'docx' ? '📝'
                      : item.output_format === 'txt'  ? '🗒️'
                      : fileIcon(item.file_name)}
                    </span>
                        <div>
                        <p style={{ margin: 0, fontWeight: 800, fontSize: 14, color: '#1a1a2e' }}>
                          {item.output_filename || item.file_name}
                        </p>
                          <p style={{ margin: 0, fontSize: 12, color: '#9090aa' }}>{formatDate(item.created_at)}</p>
                          {/* MULTIUSUARIO: cuando exista profiles, descomentar:
                          <p style={{ margin: '2px 0 0', fontSize: 11, color: '#9090aa' }}>
                            Generado por: {item.profile?.display_name ?? item.profile?.email ?? 'Usuario'}
                          </p> */}
                        </div>
                      </div>

                      <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
                        <span style={{ background: '#f0fdf9', color: '#059669', border: '1px solid #bbf7d0', borderRadius: 20, fontSize: 11, fontWeight: 700, padding: '3px 10px' }}>
                          {MODE_EMOJI[item.mode] ?? '🧠'} {item.mode}
                        </span>
                        <span style={{ background: '#f5f3ee', color: LENGTH_COLOR[item.result_length] ?? '#1a1a2e', border: '1px solid #e8e4dc', borderRadius: 20, fontSize: 11, fontWeight: 700, padding: '3px 10px' }}>
                          {item.result_length}
                        </span>
                      </div>
                    </div>

                    {/* Preview resultado */}
                    <p style={{ margin: '0 0 14px', fontSize: 13, color: '#4a4a6a', lineHeight: 1.6, background: '#fafaf8', borderRadius: 10, padding: '10px 14px' }}>
                      {preview}{hasMore && <span style={{ color: '#9090aa' }}>…</span>}
                    </p>

                    {/* Acciones */}
                    <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center' }}>
                      <button onClick={() => setSelectedItem(item)}
                        style={{ padding: '7px 14px', borderRadius: 10, border: '1.5px solid #00c9a7', background: '#f0fdf9', color: '#009e88', fontSize: 12, fontWeight: 700, cursor: 'pointer', fontFamily: "'Nunito', sans-serif" }}>
                        👁️ Ver explicación
                      </button>
                      <button onClick={() => downloadFromHistory(item)}
                        style={{ padding: '7px 14px', borderRadius: 10, border: '1.5px solid #e8e4dc', background: '#f5f3ee', color: '#4a4a6a', fontSize: 12, fontWeight: 700, cursor: 'pointer', fontFamily: "'Nunito', sans-serif" }}>
                        ⬇️ Descargar {item.output_format ? item.output_format.toUpperCase() : 'TXT'}
                      </button>
                      <button onClick={() => setConfirmDeleteId(item.id)}
                        style={{ padding: '7px 14px', borderRadius: 10, border: '1.5px solid #fca5a5', background: '#fff5f5', color: '#dc2626', fontSize: 12, fontWeight: 700, cursor: 'pointer', fontFamily: "'Nunito', sans-serif", marginLeft: 'auto' }}>
                        🗑️ Eliminar
                      </button>
                    </div>
                  </div>
                )
              })}
            </div>
          )}
        </section>

      </div>{/* /container */}

      {/* ══════════════════════════════════════
          MODAL: Ver explicación completa
      ══════════════════════════════════════ */}
      {selectedItem && (
        <div
          onClick={e => { if (e.target === e.currentTarget) setSelectedItem(null) }}
          style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.55)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 1000, padding: '1rem' }}
        >
          <div style={{ background: '#fff', borderRadius: 20, width: '100%', maxWidth: 680, maxHeight: '88vh', display: 'flex', flexDirection: 'column', boxShadow: '0 20px 60px rgba(0,0,0,0.25)' }}>

            {/* Header */}
            <div style={{ padding: '20px 24px 16px', borderBottom: '1px solid #e8e4dc', display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', gap: 12 }}>
              <div>
                <div style={{ display: 'flex', gap: 6, marginBottom: 8 }}>
                  <span style={{ background: '#f0fdf9', color: '#059669', border: '1px solid #bbf7d0', borderRadius: 20, fontSize: 11, fontWeight: 700, padding: '2px 10px' }}>
                    {MODE_EMOJI[selectedItem.mode]} {selectedItem.mode}
                  </span>
                  <span style={{ background: '#f5f3ee', color: LENGTH_COLOR[selectedItem.result_length] ?? '#1a1a2e', border: '1px solid #e8e4dc', borderRadius: 20, fontSize: 11, fontWeight: 700, padding: '2px 10px' }}>
                    {selectedItem.result_length}
                  </span>
                </div>
                <p style={{ margin: 0, fontWeight: 800, fontSize: 15, color: '#1a1a2e' }}>
                {selectedItem.output_filename || selectedItem.file_name}
              </p>
                <p style={{ margin: '3px 0 0', fontSize: 12, color: '#9090aa' }}>
                  {new Date(selectedItem.created_at).toLocaleDateString('es-MX', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
                </p>
              </div>
              <button onClick={() => setSelectedItem(null)}
                style={{ background: 'none', border: 'none', fontSize: 22, cursor: 'pointer', color: '#9090aa', lineHeight: 1, padding: 4, flexShrink: 0 }}>
                ✕
              </button>
            </div>

            {/* Contenido scrolleable */}
            <div style={{ padding: '20px 24px', overflowY: 'auto', flex: 1 }}>
              <p style={{ fontSize: 14, color: '#1a1a2e', lineHeight: 1.85, whiteSpace: 'pre-wrap', margin: 0 }}>
                {selectedItem.result_text}
              </p>
            </div>

            {/* Footer */}
            <div style={{ padding: '16px 24px', borderTop: '1px solid #e8e4dc', display: 'flex', gap: 10, justifyContent: 'flex-end' }}>
              <button onClick={() => downloadFromHistory(selectedItem)}
                style={{ padding: '9px 20px', borderRadius: 10, border: '1.5px solid #e8e4dc', background: '#f5f3ee', color: '#4a4a6a', fontSize: 13, fontWeight: 700, cursor: 'pointer', fontFamily: "'Nunito', sans-serif" }}>
                ⬇️ Descargar {selectedItem.output_format ? selectedItem.output_format.toUpperCase() : 'TXT'}
              </button>
              <button onClick={() => setSelectedItem(null)}
                className={styles.btnPlanPro} style={{ padding: '9px 24px', fontSize: 13 }}>
                Cerrar
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ══════════════════════════════════════
          MODAL: Confirmar eliminación
      ══════════════════════════════════════ */}
      {confirmDeleteId && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.55)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 1000, padding: '1rem' }}>
          <div style={{ background: '#fff', borderRadius: 20, padding: '28px 24px', maxWidth: 400, width: '100%', textAlign: 'center', boxShadow: '0 20px 60px rgba(0,0,0,0.25)' }}>
            <p style={{ fontSize: 40, margin: '0 0 12px' }}>🗑️</p>
            <h3 style={{ margin: '0 0 8px', color: '#1a1a2e', fontSize: 18, fontWeight: 800 }}>¿Eliminar esta explicación?</h3>
            <p style={{ color: '#6b6b8a', fontSize: 13, margin: '0 0 24px' }}>Esta acción no se puede deshacer.</p>
            <div style={{ display: 'flex', gap: 10 }}>
              <button onClick={() => setConfirmDeleteId(null)} disabled={deleting}
                style={{ flex: 1, padding: '11px', borderRadius: 12, border: '1.5px solid #e8e4dc', background: '#f5f3ee', color: '#4a4a6a', fontSize: 14, fontWeight: 700, cursor: 'pointer', fontFamily: "'Nunito', sans-serif" }}>
                Cancelar
              </button>
              <button onClick={() => handleDelete(confirmDeleteId)} disabled={deleting}
                style={{ flex: 1, padding: '11px', borderRadius: 12, border: 'none', background: '#dc2626', color: '#fff', fontSize: 14, fontWeight: 700, cursor: deleting ? 'not-allowed' : 'pointer', fontFamily: "'Nunito', sans-serif", opacity: deleting ? 0.7 : 1 }}>
                {deleting ? 'Eliminando…' : 'Sí, eliminar'}
              </button>
            </div>
          </div>
        </div>
      )}

    </div>
  )
}
</file>

